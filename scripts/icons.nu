# Fusuma — the Lucide icon set (crates/fusuma-icons)
# ──────────────────────────────────────────────────────────────────────────────
# Downloads lucide-static's icon font and its name table, and writes `crates/fusuma-icons/src/names.rs`: every icon's
# name and character, sorted by name, and an `Icon` enum with one variant per name. The font and the generated file are committed, so a
# build needs no network.
#
#   nu scripts/icons.nu fetch            # the pinned version
#   nu scripts/icons.nu fetch --version 1.81.0
# ──────────────────────────────────────────────────────────────────────────────

const CRATE = path self ../crates/fusuma-icons
export const VERSION = "1.80.0"

# The name of an icon as a Rust enum variant: `arrow-left` is `ArrowLeft`, `2k` is `N2k` (a name cannot start with a digit).
export def variant_name [name: string]: nothing -> string {
    let words = $name | split row "-" | each { |w| ($w | str substring 0..0 | str uppercase) + ($w | str substring 1..) }
    let pascal = $words | enumerate | each { |w|
        let digit = $w.item =~ '^[0-9]'
        let after_digit = $w.index > 0 and (($words | get ($w.index - 1)) =~ '[0-9]$')
        if $digit and $after_digit { $"_($w.item)" } else { $w.item }
    } | str join
    if ($pascal =~ '^[0-9]') { $"N($pascal)" } else { $pascal }
}

# The icons as rows `name`, `hex` from lucide-static's info.json, sorted by name.
export def parse_info [text: string]: nothing -> table<name: string, hex: string> {
    $text | from json | transpose name info | each { |r|
        { name: $r.name, hex: ($r.info.encodedCode | str replace --regex '^\\' '' | str lowercase) }
    } | sort-by name
}

# The generated Rust file for these icons: the `Icon` enum in the order of the sorted names, and the two tables
# indexed by it.
export def render [icons: table<name: string, hex: string>]: nothing -> string {
    let variants = $icons | each { |i| $"    /// `($i.name)`.\n    (variant_name $i.name)," } | str join "\n"
    let names = $icons | each { |i| $"    \"($i.name)\"," } | str join "\n"
    let glyphs = $icons | each { |i| $"    '\\u{($i.hex)}'," } | str join "\n"
    let all = $icons | each { |i| $"        Self::(variant_name $i.name)," } | str join "\n"
    [
        "// Generated by `nu scripts/icons.nu fetch`: do not edit."
        ""
        "/// How many icons there are."
        $"pub const COUNT: usize = ($icons | length);"
        ""
        "/// An icon of the Lucide set, by its name on lucide.dev in PascalCase (`arrow-left` is `ArrowLeft`)."
        "///"
        "/// The variants are in the order of the sorted names, so an icon is its own index into the tables."
        "#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]"
        "#[repr(u16)]"
        "#[allow(non_camel_case_types, reason = \"Lucide's `arrow-down-0-1` and `arrow-down-01` are two icons\")]"
        "pub enum Icon {"
        $variants
        "}"
        ""
        "impl Icon {"
        "    /// Every icon, in the order of the sorted names."
        "    pub const ALL: [Self; COUNT] = ["
        $all
        "    ];"
        "}"
        ""
        "/// Every icon's name on lucide.dev, sorted; the index is the icon's."
        "pub(crate) static NAMES: [&str; COUNT] = ["
        $names
        "];"
        ""
        "/// Every icon's character in the font, in the order of the names."
        "pub(crate) static GLYPHS: [char; COUNT] = ["
        $glyphs
        "];"
        ""
    ] | str join "\n"
}

# Download the font, its licence and the name table, and write the crate's files.
def "main fetch" [--version: string = $VERSION] {
    let base = $"https://unpkg.com/lucide-static@($version)/font"
    let fonts = $CRATE | path join fonts
    mkdir $fonts
    http get --raw $"($base)/lucide.ttf" | save --force ($fonts | path join lucide.ttf)
    http get --raw https://raw.githubusercontent.com/lucide-icons/lucide/main/LICENSE | save --force ($fonts | path join LICENSE-lucide.txt)
    let icons = parse_info (http get --raw $"($base)/info.json" | decode utf-8)
    let variants = $icons | each { |i| variant_name $i.name }
    if ($variants | uniq | length) != ($variants | length) { error make { msg: "two icon names make one variant" } }
    render $icons | save --force ($CRATE | path join src names.rs)
    print $"($icons | length) icons from lucide-static ($version)"
}

def main [] { print "nu scripts/icons.nu fetch [--version <v>]" }
