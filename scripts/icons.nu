# Fusuma — the Lucide icon set (crates/fusuma-icons)
# ──────────────────────────────────────────────────────────────────────────────
# Downloads lucide-static's icon font and its name table, and writes `crates/fusuma-icons/src/names.rs`: every icon's
# name and character, sorted by name, and one `const` per name. The font and the generated file are committed, so a
# build needs no network.
#
#   nu scripts/icons.nu fetch            # the pinned version
#   nu scripts/icons.nu fetch --version 1.81.0
# ──────────────────────────────────────────────────────────────────────────────

const CRATE = path self ../crates/fusuma-icons
export const VERSION = "1.80.0"

# The name of an icon as a Rust constant: `arrow-left` is `ARROW_LEFT`, `2k` is `N2K` (a name cannot start with a digit).
export def const_name [name: string]: nothing -> string {
    let up = $name | str uppercase | str replace --all "-" "_"
    if ($up =~ '^[0-9]') { $"N($up)" } else { $up }
}

# The icons as rows `name`, `hex` from lucide-static's info.json, sorted by name.
export def parse_info [text: string]: nothing -> table<name: string, hex: string> {
    $text | from json | transpose name info | each { |r|
        { name: $r.name, hex: ($r.info.encodedCode | str replace --regex '^\\' '' | str lowercase) }
    } | sort-by name
}

# The generated Rust file for these icons.
export def render [icons: table<name: string, hex: string>]: nothing -> string {
    let table = $icons | each { |i| $"    \(\"($i.name)\", '\\u{($i.hex)}'\)," } | str join "\n"
    let consts = $icons | each { |i|
        $"/// `($i.name)`.\npub const (const_name $i.name): char = '\\u{($i.hex)}';"
    } | str join "\n"
    [
        "// Generated by `nu scripts/icons.nu fetch`: do not edit."
        ""
        $"/// How many names there are \(some icons have more than one name\)."
        $"pub const COUNT: usize = ($icons | length);"
        ""
        "/// Every icon's name and character, sorted by name."
        "pub static NAMES: [(&str, char); COUNT] = ["
        $table
        "];"
        ""
        $consts
        ""
    ] | str join "\n"
}

# Download the font, its licence and the name table, and write the crate's files.
def "main fetch" [--version: string = $VERSION] {
    let base = $"https://unpkg.com/lucide-static@($version)/font"
    let fonts = $CRATE | path join fonts
    mkdir $fonts
    http get --raw $"($base)/lucide.ttf" | save --force ($fonts | path join lucide.ttf)
    http get --raw https://raw.githubusercontent.com/lucide-icons/lucide/main/LICENSE | save --force ($fonts | path join LICENSE-lucide.txt)
    let icons = parse_info (http get --raw $"($base)/info.json" | decode utf-8)
    let consts = $icons | each { |i| const_name $i.name }
    if ($consts | uniq | length) != ($consts | length) { error make { msg: "two icon names make one constant" } }
    render $icons | save --force ($CRATE | path join src names.rs)
    print $"($icons | length) icons from lucide-static ($version)"
}

def main [] { print "nu scripts/icons.nu fetch [--version <v>]" }
